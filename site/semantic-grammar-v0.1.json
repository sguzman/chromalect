{
  "schema": "chromalect.semantic.grammar.v0.1",
  "version": "0.1.0",
  "status": "experimental_not_production_semantics",
  "verifiedProductionCharacterCount": 0,
  "description": "Versioned, reusable typed emoji expression grammar. Examples illustrate possible readings; pictograms do not constitute dictionary evidence.",
  "operators": [
    {
      "id": "atom",
      "display": "emoji",
      "interpretation": "Reusable pictogram denoting a chosen concept, according to a reviewed lexicon."
    },
    {
      "id": "associate",
      "display": "∼",
      "interpretation": "Mnemonic conceptual association only. Does not imply equivalence, causation, action or definition."
    },
    {
      "id": "and",
      "display": "+",
      "interpretation": "Both concepts / conjunction, not a new lexicalized object."
    },
    {
      "id": "qualify",
      "display": "·",
      "interpretation": "A property or qualifier applied to a head concept; left modifies right."
    },
    {
      "id": "change",
      "display": "⇒",
      "interpretation": "Transition from the left state to the right state, not necessarily causation."
    },
    {
      "id": "event",
      "display": "▶",
      "interpretation": "Action or process marker. The predicate may be lexicalized, but its reading must be recorded separately."
    },
    {
      "id": "not",
      "display": "¬(...)",
      "interpretation": "Negates exactly the enclosed expression, without implying a particular tense."
    }
  ],
  "roles": [
    {
      "id": "agent",
      "symbol": "A",
      "meaning": "initiator or doer of an event"
    },
    {
      "id": "patient",
      "symbol": "P",
      "meaning": "entity directly affected by an event"
    },
    {
      "id": "goal",
      "symbol": "G",
      "meaning": "destination or endpoint"
    },
    {
      "id": "source",
      "symbol": "S",
      "meaning": "starting point or origin"
    },
    {
      "id": "instrument",
      "symbol": "I",
      "meaning": "means or tool used"
    }
  ],
